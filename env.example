# Copy to .env and fill in. NEVER commit .env.

# --- Database (PostgreSQL). Leave empty for a dry run that writes nothing.
DATABASE_URL=
# DB_DRY_RUN=1                  # force a dry run even when DATABASE_URL is set

# --- LLM keys (add as many as you like; calls alternate between them)
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# or comma separated: GROQ_API_KEYS=a,b   GEMINI_API_KEYS=a,b

# --- Optional tuning
# LLM_PROVIDERS=groq,gemini     # order of use (first = primary); leave unset for the default: groq, gemini
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT=45
# LLM_COOLDOWN=300
# GEMINI_MIN_INTERVAL=4
# GROQ_MIN_INTERVAL=20
# BROWSER_CHANNEL=chrome        # chrome | msedge (browser fallback)
